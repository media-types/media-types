<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Media Types with File Extensions</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 1rem; }
    table { border-collapse: collapse; font-size: 10pt; }
    th, td { border: 1px solid #ccc; padding-left: 0.5em; padding-right: 0.5em; text-align: left; vertical-align: top; }
    th { background: #f5f5f5; }
    a { color: #0b57d0; }
  </style>
</head>
<body>
  <h1>Media Types with File Extensions</h1>
  <p>
    This page contains the generated artifacts from
    <a href="https://github.com/media-types/media-types">https://github.com/media-types/media-types</a>.
  </p>
  <h2>mime.types</h2>
  <p>
    Download: <a href="mime.types">mime.types</a><br/>
    Show as text: <a href="mime.types.html">mime.types</a>
  </p>
  <h2>media-types.csv</h2>
  <p>Download the CSV: <a href="media-types.csv">media-types.csv</a></p>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Template</th>
        <th>Primary File Extensions</th>
        <th>File Extensions</th>
        <th>Intended Usage</th>
        <th>Reference</th>
      </tr>
    </thead>
    <tbody>
{%- for row in media_types %}
<tr><td>{{ row.name }}</td><td><a href="{{ row.template }}.txt">{{ row.template }}</a></td><td>{{ row.primary_file_extensions | join(" ") }}</td><td>{{ row.file_extensions | join(" ") }}</td><td>{{ row.intended_usage }}</td><td>{{ row.reference }}</td></tr>
{%- endfor %}
    </tbody>
  </table>
  <p>
    <b>Statistics</b>:
    <ul>
      <li>Total media types: {{ media_types | length }}</li>
      <li>Media types with file extension(s): {{ media_types | selectattr('file_extensions') | list | length }}</li>
      <li>Media types with primary file extension(s): {{ media_types | selectattr('primary_file_extensions') | list | length }}</li>
      <li>Media types per intended usage:</li>
      <ul>
        <li>Common: {{ media_types | selectattr('intended_usage', 'equalto', 'Common') | list | length }}</li>
        <li>Limited use: {{ media_types | selectattr('intended_usage', 'equalto', 'Limited use') | list | length }}</li>
        <li>Obsolete: {{ media_types | selectattr('intended_usage', 'equalto', 'Obsolete') | list | length }}</li>
        <li>Not specified: {{ media_types | selectattr('intended_usage', 'equalto', '') | list | length }}</li>
      </ul>
    </ul>
  </p>
  <h2>iana.csv</h2>
  <p>
    Download the CSV: <a href="iana.csv">iana.csv</a><br/>
    Show the table: <a href="iana.html">iana</a>
  </p>
</body>
</html>
